{
  "permissions": {
    "allow": [
      "Edit(/.pipeline/**)",
      "Bash(git rev-parse:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-I",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/java_lint.py"
            ],
            "timeout": 200,
            "statusMessage": "Checkstyle dla edytowanego pliku Java"
          }
        ]
      }
    ]
  }
}
